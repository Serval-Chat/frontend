{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serchat",
  "version": "0.1.0",
  "identifier": "pl.catflare.serchat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Serchat",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "https://challenges.cloudflare.com"],
        "style-src": ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"],
        "font-src": ["'self'", "https://fonts.gstatic.com", "data:"],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "https://*.tenor.com",
          "https://*.googleapis.com",
          "https://*.githubusercontent.com",
          "https://www.gravatar.com",
          "https://ser.chat",
          "https://catfla.re",
          "https://rolling.catfla.re",
          "https://static.klipy.com",
          "http://127.0.0.1:3000",
          "http://localhost:3000"
        ],
        "media-src": ["'self'", "https:", "http:", "data:", "blob:"],
        "connect-src": [
          "'self'",
          "https://ser.chat",
          "wss://ser.chat",
          "https://catfla.re",
          "https://rolling.catfla.re",
          "wss://catfla.re",
          "wss://rolling.catfla.re",
          "https://rtc.catfla.re",
          "wss://rtc.catfla.re",
          "http://127.0.0.1:3000",
          "ws://127.0.0.1:3000",
          "http://localhost:3000",
          "ws://localhost:3000",
          "http://127.0.0.1:17880",
          "ws://127.0.0.1:17880"
        ],
        "frame-src": [
          "https://www.youtube.com",
          "https://www.youtube-nocookie.com",
          "https://challenges.cloudflare.com"
        ],
        "object-src": ["'none'"]
      }
    }
  },
  "plugins": {
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
